# =============================================================================
# UYGULAMA
# =============================================================================
NODE_ENV=development
PORT=3000
# NOT (Faz 7.1): 'api' olarak bırakın — 'v1' segmenti URI versioning
# tarafından ayrıca eklenir, sonuç: /api/v1/... (bkz. src/main.ts notu).
API_PREFIX=api
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# Faz 7.3 — boş bırakılırsa NODE_ENV'e göre otomatik seçilir (production: info,
# development: debug). Geçerli değerler: trace, debug, info, warn, error, fatal.
LOG_LEVEL=

# =============================================================================
# VERİTABANI (PostgreSQL)
# =============================================================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/discord_clone?schema=public

# =============================================================================
# REDIS (Cache, oturum, rate-limit, pub/sub)
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# =============================================================================
# JWT KİMLİK DOĞRULAMA
# =============================================================================
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_SECRET_MIN_32_CHARS
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET_MIN_32_CHARS
JWT_REFRESH_EXPIRES_IN=30d

# =============================================================================
# S3 UYUMLU DEPOLAMA (Cloudflare R2 / MinIO)
# =============================================================================
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=discord-clone-media
S3_PUBLIC_URL=http://localhost:9000/discord-clone-media

# =============================================================================
# LIVEKIT (Sesli/Görüntülü/Ekran Paylaşımı Medya Sunucusu)
# =============================================================================
# Yerel geliştirme: docker-compose.yml içindeki "livekit" servisi --dev modunda
# çalışır ve sabit "devkey/secret" anahtarlarını kullanır. Üretimde MUTLAKA
# kendi LiveKit Cloud projenizin ya da self-hosted sunucunuzun gerçek
# anahtarlarıyla değiştirin.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# =============================================================================
# E-POSTA (Doğrulama / Şifre Sıfırlama)
# =============================================================================
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
MAIL_FROM=no-reply@yourdomain.com

# =============================================================================
# GÜVENLİK
# =============================================================================
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
